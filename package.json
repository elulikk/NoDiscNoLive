{
  "name": "nodiscnolive",
  "productName": "NoDiscNoLive",
  "version": "1.0.0",
  "description": "Examina discos y volúmenes de Windows y genera informes de diagnóstico en PDF (MAG).",
  "main": "src/main/main.js",
  "author": "MAG",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.js",
    "build": "node scripts/build.js",
    "shortcut": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/crear-acceso-directo.ps1"
  },
  "build": {
    "appId": "com.mag.nodiscnolive",
    "productName": "NoDiscNoLive",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0"
  }
}